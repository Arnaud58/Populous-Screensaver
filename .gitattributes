# The work moves between a Windows machine and a KDE one, so the working tree
# is kept identical on both: LF everywhere, not just LF in the repository.
#
# Without this, git stores LF and hands a Windows checkout CRLF. Nothing breaks
# in git itself, but anything comparing a generated file against a stored one
# as text sees every line differ. That is how `generate-golden.mjs --check`
# came to fail permanently on Windows while the traces were byte-identical.

* text=auto eol=lf

# Generated by the asset pipeline. Listed explicitly because they are the files
# the golden and manifest comparisons read back.
*.json text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.qml  text eol=lf
*.py   text eol=lf
*.md   text eol=lf

# Never touch these: a line-ending conversion inside a sprite sheet, a sound or
# the original executable would corrupt it.
*.png  binary
*.gif  binary
*.bmp  binary
*.jpg  binary
*.ico  binary
*.wav  binary
*.mp4  binary
*.zip  binary
*.scr  binary
*.exe  binary
*.dll  binary
